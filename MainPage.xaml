<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.MainPage"
             Title="Анкета кандидата">

    <ScrollView x:Name="RootScrollView"
                Padding="0">
        <Grid x:Name="SurveyGrid"
              Padding="20"
              RowSpacing="10"
              ColumnSpacing="12"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
              ColumnDefinitions="160,*">

            <Image x:Name="LogoImage"
                   Grid.Row="0"
                   Grid.Column="0"
                   Grid.ColumnSpan="2"
                   Source="dotnet_bot.png"
                   Aspect="AspectFit"
                   HeightRequest="120"
                   Margin="0,0,0,10" />

            <Label x:Name="TitleLabel"
                   Grid.Row="1"
                   Grid.Column="0"
                   Grid.ColumnSpan="2"
                   Text="Анкета кандидата на стажировку backend-разработчиком"
                   FontSize="22"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   Margin="0,0,0,5" />

            <Label x:Name="SubtitleLabel"
                   Grid.Row="2"
                   Grid.Column="0"
                   Grid.ColumnSpan="2"
                   Text="Поля ФИО и Email обязательны для заполнения"
                   FontSize="14"
                   FontAttributes="Italic"
                   HorizontalTextAlignment="Center"
                   Margin="0,0,0,10" />

            <Label x:Name="FullNameCaption"
                   Grid.Row="3"
                   Grid.Column="0"
                   Text="ФИО *"
                   FontSize="16"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   Margin="0,5" />
            <Entry x:Name="FullNameEntry"
                   Grid.Row="3"
                   Grid.Column="1"
                   Placeholder="Иванов Иван Иванович"
                   Keyboard="Text"
                   MaxLength="100"
                   Text=""
                   TextChanged="OnRequiredFieldTextChanged"
                   Margin="0,5" />

            <Label x:Name="EmailCaption"
                   Grid.Row="4"
                   Grid.Column="0"
                   Text="Email *"
                   FontSize="16"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   Margin="0,5" />
            <Entry x:Name="EmailEntry"
                   Grid.Row="4"
                   Grid.Column="1"
                   Placeholder="example@mail.ru"
                   Keyboard="Email"
                   MaxLength="100"
                   Text=""
                   TextChanged="OnRequiredFieldTextChanged"
                   Margin="0,5" />

            <Label x:Name="PhoneCaption"
                   Grid.Row="5"
                   Grid.Column="0"
                   Text="Телефон"
                   FontSize="16"
                   FontAttributes="None"
                   VerticalOptions="Center"
                   Margin="0,5" />
            <Entry x:Name="PhoneEntry"
                   Grid.Row="5"
                   Grid.Column="1"
                   Placeholder="+7 900 000-00-00"
                   Keyboard="Telephone"
                   MaxLength="20"
                   Text=""
                   Margin="0,5" />

            <Label x:Name="AboutCaption"
                   Grid.Row="6"
                   Grid.Column="0"
                   Text="О себе"
                   FontSize="16"
                   FontAttributes="None"
                   VerticalOptions="Start"
                   Margin="0,5" />
            <Editor x:Name="AboutEditor"
                    Grid.Row="6"
                    Grid.Column="1"
                    Placeholder="Расскажите о своих проектах"
                    AutoSize="TextChanges"
                    MaxLength="500"
                    Text=""
                    Margin="0,5" />

            <Label x:Name="LanguageCaption"
                   Grid.Row="7"
                   Grid.Column="0"
                   Text="Основной язык"
                   FontSize="16"
                   FontAttributes="None"
                   VerticalOptions="Center"
                   Margin="0,5" />
            <Picker x:Name="LanguagePicker"
                    Grid.Row="7"
                    Grid.Column="1"
                    Title="Выберите язык"
                    SelectedIndex="-1"
                    Margin="0,5">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>C#</x:String>
                        <x:String>Python</x:String>
                        <x:String>Go</x:String>
                        <x:String>Java</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>

            <Label x:Name="EmploymentCaption"
                   Grid.Row="8"
                   Grid.Column="0"
                   Text="Формат занятости"
                   FontSize="16"
                   FontAttributes="None"
                   VerticalOptions="Start"
                   Margin="0,5" />
            <VerticalStackLayout x:Name="EmploymentGroup"
                                 Grid.Row="8"
                                 Grid.Column="1"
                                 Spacing="4"
                                 Margin="0,5">
                <RadioButton x:Name="FullTimeRadio"
                             Content="Полный день"
                             GroupName="EmploymentType"
                             Value="Полный день"
                             IsChecked="False"
                             Margin="0" />
                <RadioButton x:Name="PartTimeRadio"
                             Content="Частичная занятость"
                             GroupName="EmploymentType"
                             Value="Частичная занятость"
                             IsChecked="False"
                             Margin="0" />
                <RadioButton x:Name="RemoteRadio"
                             Content="Удалённо"
                             GroupName="EmploymentType"
                             Value="Удалённо"
                             IsChecked="False"
                             Margin="0" />
            </VerticalStackLayout>

            <Label x:Name="SkillsCaption"
                   Grid.Row="9"
                   Grid.Column="0"
                   Text="Навыки"
                   FontSize="16"
                   FontAttributes="None"
                   VerticalOptions="Start"
                   Margin="0,5" />
            <VerticalStackLayout x:Name="SkillsGroup"
                                 Grid.Row="9"
                                 Grid.Column="1"
                                 Spacing="2"
                                 Margin="0,5">
                <HorizontalStackLayout Spacing="8"
                                       Margin="0">
                    <CheckBox x:Name="SqlCheckBox"
                              IsChecked="False"
                              Color="#512BD4"
                              Margin="0" />
                    <Label Text="Знаю SQL"
                           FontSize="15"
                           FontAttributes="None"
                           VerticalOptions="Center"
                           Margin="0" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="8"
                                       Margin="0">
                    <CheckBox x:Name="DockerCheckBox"
                              IsChecked="False"
                              Color="#512BD4"
                              Margin="0" />
                    <Label Text="Знаю Docker"
                           FontSize="15"
                           FontAttributes="None"
                           VerticalOptions="Center"
                           Margin="0" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="8"
                                       Margin="0">
                    <CheckBox x:Name="GitCheckBox"
                              IsChecked="False"
                              Color="#512BD4"
                              Margin="0" />
                    <Label Text="Знаком с Git"
                           FontSize="15"
                           FontAttributes="None"
                           VerticalOptions="Center"
                           Margin="0" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="8"
                                       Margin="0">
                    <CheckBox x:Name="RestCheckBox"
                              IsChecked="False"
                              Color="#512BD4"
                              Margin="0" />
                    <Label Text="Понимаю REST API"
                           FontSize="15"
                           FontAttributes="None"
                           VerticalOptions="Center"
                           Margin="0" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <Label x:Name="CommercialCaption"
                   Grid.Row="10"
                   Grid.Column="0"
                   Text="Есть коммерческий опыт"
                   FontSize="16"
                   FontAttributes="None"
                   VerticalOptions="Center"
                   Margin="0,5" />
            <Switch x:Name="CommercialSwitch"
                    Grid.Row="10"
                    Grid.Column="1"
                    IsToggled="False"
                    OnColor="#512BD4"
                    HorizontalOptions="Start"
                    Toggled="OnCommercialSwitchToggled"
                    Margin="0,5" />

            <HorizontalStackLayout x:Name="ExperienceBlock"
                                   Grid.Row="11"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="2"
                                   Spacing="12"
                                   IsVisible="False"
                                   Margin="0,5">
                <Label x:Name="ExperienceCaption"
                       Text="Опыт, мес."
                       FontSize="16"
                       FontAttributes="None"
                       VerticalOptions="Center"
                       Margin="0" />
                <Stepper x:Name="ExperienceStepper"
                         Maximum="60"
                         Minimum="0"
                         Increment="1"
                         Value="0"
                         VerticalOptions="Center"
                         Margin="0" />
                <Label x:Name="ExperienceValueLabel"
                       Text="{Binding Source={x:Reference ExperienceStepper}, Path=Value, Mode=OneWay, StringFormat='{0:F0} мес.'}"
                       FontSize="16"
                       FontAttributes="Bold"
                       VerticalOptions="Center"
                       Margin="0" />
            </HorizontalStackLayout>

            <Label x:Name="BirthDateCaption"
                   Grid.Row="12"
                   Grid.Column="0"
                   Text="Дата рождения"
                   FontSize="16"
                   FontAttributes="None"
                   VerticalOptions="Center"
                   Margin="0,5" />
            <DatePicker x:Name="BirthDatePicker"
                        Grid.Row="12"
                        Grid.Column="1"
                        Format="dd.MM.yyyy"
                        MinimumDate="1950-01-01"
                        MaximumDate="2010-12-31"
                        Date="2000-01-01"
                        HorizontalOptions="Start"
                        Margin="0,5" />

            <Label x:Name="HoursCaption"
                   Grid.Row="13"
                   Grid.Column="0"
                   Text="Готов работать часов в неделю"
                   FontSize="16"
                   FontAttributes="None"
                   VerticalOptions="Center"
                   Margin="0,5" />
            <VerticalStackLayout x:Name="HoursGroup"
                                 Grid.Row="13"
                                 Grid.Column="1"
                                 Spacing="4"
                                 Margin="0,5">
                <Slider x:Name="HoursSlider"
                        Maximum="40"
                        Minimum="10"
                        Value="20"
                        MinimumTrackColor="#512BD4"
                        ValueChanged="OnHoursSliderValueChanged"
                        Margin="0" />
                <Label x:Name="HoursValueLabel"
                       Text="{Binding Source={x:Reference HoursSlider}, Path=Value, Mode=OneWay, StringFormat='{0:F0} ч/нед'}"
                       FontSize="15"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       Margin="0" />
            </VerticalStackLayout>

            <HorizontalStackLayout x:Name="ButtonsGroup"
                                   Grid.Row="14"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="2"
                                   Spacing="12"
                                   HorizontalOptions="Center"
                                   Margin="0,15,0,5">
                <Button x:Name="ShowResultButton"
                        Text="Показать результат"
                        IsEnabled="False"
                        Clicked="OnShowResultClicked"
                        Margin="0" />
                <Button x:Name="ClearButton"
                        Text="Очистить"
                        Clicked="OnClearClicked"
                        Margin="0" />
            </HorizontalStackLayout>

            <Label x:Name="ResultLabel"
                   Grid.Row="15"
                   Grid.Column="0"
                   Grid.ColumnSpan="2"
                   Text=""
                   FontSize="15"
                   FontAttributes="None"
                   IsVisible="False"
                   Margin="0,10,0,0" />
        </Grid>
    </ScrollView>

</ContentPage>
